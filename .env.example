# Database Configuration (MySQL or SQLite fallback)
# For MySQL: mysql+pymysql://<user>:<password>@localhost:3306/<database>
# For SQLite (default out-of-the-box local testing): sqlite:///./resume_ai.db
DATABASE_URL=sqlite:///./resume_ai.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/resume_ai

# JWT Security
JWT_SECRET=super-secret-college-nlp-jwt-key-2024-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Directory
UPLOAD_DIR=uploads/resumes
